{
  "name": "agentdu-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AgentDU local-first desktop application",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "pnpm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env AGENTDU_DESKTOP_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "pnpm run typecheck && pnpm run build:renderer && pnpm run build:electron",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare:runtime": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-runtime.ps1",
    "verify:appcontainer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-appcontainer.ps1",
    "package:win": "pnpm run build && pnpm run prepare:runtime && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "45.4.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.agentdu.desktop",
    "productName": "AgentDU",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "agentdu-runtime"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AgentDU-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
